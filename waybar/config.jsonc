{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/theme-pill"
  ],
  "modules-right": [
    "custom/shield",
    "pulseaudio",
    "network",
    "battery",
    "clock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace m-1",
    "on-scroll-down": "hyprctl dispatch workspace m+1",
    "persistent-workspaces": {
      "*": 9
    }
  },
  "hyprland/window": {
    "max-length": 44,
    "separate-outputs": true
  },
  "custom/theme-pill": {
    "exec": "/home/emir-alkan/.local/bin/theme pill",
    "signal": 8,
    "return-type": "json",
    "on-click": "/home/emir-alkan/.local/bin/theme-hud",
    "on-click-right": "/home/emir-alkan/.local/bin/theme next",
    "tooltip": true
  },
  "custom/shield": {
    "exec": "/home/emir-alkan/.local/bin/theme shield-status",
    "signal": 8,
    "return-type": "json",
    "on-click": "/home/emir-alkan/.local/bin/theme shield toggle",
    "tooltip": true
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL MUT",
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format": "NET {essid}",
    "format-disconnected": "NET --",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT+ {capacity}%",
    "tooltip": false
  },
  "clock": {
    "format": "{:%d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M}"
  },
  "custom/power": {
    "format": "[ PWR ]",
    "tooltip": "cikis menusu (Super+X)",
    "on-click": "/home/emir-alkan/.local/bin/power-menu"
  }
}